group/

# Local Data & Outputs (privacy)
# Keep directories tracked via .gitkeep
data/*
output/*
!data/.gitkeep
!output/.gitkeep

# Sensitive & Privacy Files
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
config.local.*
credentials.*

# Database Files
*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb
.kiro/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
