# Chat Data
group/
data/
output/

# Local Data & Outputs (privacy)
# Keep directories tracked via .gitkeep
data/*
output/*
!data/.gitkeep
!output/.gitkeep

# Sensitive & Privacy Files
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
config.local.*
credentials.*

# Database Files
*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb
.kiro/

# Python 相关忽略规则
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# 虚拟环境与包管理
.venv/
venv/
env/
uv.lock
pyproject.toml
.python-version

# 日志与 AI 标识
*.log
AGENTS.md
