# ========== 导入选项 ==========
# 是否包含入群时间
INCLUDE_JOIN_TIME=false
# 是否不生成个人文件
NO_INDIVIDUAL=false

# ========== 模型配置 (必需) ==========
# 使用 Gemini (默认)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=YOUR_API_KEY_HERE

# 或者切换到 OpenAI
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# AI_API_KEY=YOUR_API_KEY_HERE
# AI_BASE_URL=https://api.openai.com/v1

# 或者切换到 Anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20240620
# AI_API_KEY=YOUR_API_KEY_HERE

# ========== 报告选项 ==========
# 统计开始日期 (如: 2026-01-01)
PERIOD_START=
# 统计结束日期 (如: 2026-01-31)
PERIOD_END=
# 报告期号
REPORT_NUMBER=1

# ========== 技能配置 (可选) ==========
TEMPLATE_PATH=.opencode/skills/generate-report/template.md
OUTPUT_PATH=output/report.md
