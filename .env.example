# ========== 导入选项 ==========
# 是否包含入群时间
INCLUDE_JOIN_TIME=false
# 是否不生成个人文件
NO_INDIVIDUAL=false

# ========== API 配置 (必需) ==========
# API 提供商 (google)
API_PROVIDER=google
# AI 模型
MODEL=gemini-2.5-flash
# ← 必须填写！
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# ========== 代理配置 (可选) ==========
# HTTP 代理
HTTP_PROXY=
# HTTPS 代理
HTTPS_PROXY=

# ========== 报告选项 ==========
# 统计开始日期 (如: 2026-01-01)
PERIOD_START=
# 统计结束日期 (如: 2026-01-31)
PERIOD_END=
# 报告期号
REPORT_NUMBER=1

# ========== 技能配置 (可选) ==========
TEMPLATE_PATH=.opencode/skills/generate-report/template.md
OUTPUT_PATH=output/report.md
