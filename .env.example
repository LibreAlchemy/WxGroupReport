# ========== 模型配置 (必需) ==========
# 使用 Gemini (默认)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=YOUR_API_KEY_HERE
MAX_ANALYZE_WORKERS=10

# 或者切换到 OpenAI
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# AI_API_KEY=YOUR_API_KEY_HERE
# AI_BASE_URL=https://api.openai.com/v1

# 或者切换到 Anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20240620
# AI_API_KEY=YOUR_API_KEY_HERE

# ========== 推理参数 ==========
# 采样温度：默认 0.3，有效范围 0.0-2.0
# AI_TEMPERATURE=0.3
# 思考等级：留空或注释掉表示关闭；常见取值 minimal|low|medium|high|xhigh，实际以 provider 支持为准
# REASONING_EFFORT=low

# ========== 报告选项 ==========
# 报告期号
REPORT_NUMBER=1
