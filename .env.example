# ========== 模型配置 (必需) ==========
# 使用 Gemini (默认)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=YOUR_API_KEY_HERE
MAX_ANALYZE_WORKERS=10

# 或者切换到 OpenAI
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# AI_API_KEY=YOUR_API_KEY_HERE
# AI_BASE_URL=https://api.openai.com/v1

# 或者切换到 Anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20240620
# AI_API_KEY=YOUR_API_KEY_HERE

# ========== 报告选项 ==========
# 报告期号
REPORT_NUMBER=1
